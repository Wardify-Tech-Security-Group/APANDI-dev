<IfModule mod_rewrite.c>
  RewriteEngine On

  # Bloquear acceso web directo a archivos ocultos (.env, .git, .htaccess) y volcados (.sql, .log, .bak)
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(sql|gz|bak|dump|env|log|ini|sh|key|pem)$ - [F,L,NC]

  # Permitir cabeceras Authorization JWT en cualquier Hosting cPanel / Apache de Chile
  RewriteCond %{HTTP:Authorization} ^(.*)
  RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

  # Redirigir llamadas a /api/... hacia el puente universal /api/index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^api/(.*)$ api/index.php?route=$1 [QSA,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
